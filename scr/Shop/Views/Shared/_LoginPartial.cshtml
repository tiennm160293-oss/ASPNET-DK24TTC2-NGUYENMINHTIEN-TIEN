@using Microsoft.AspNet.Identity
@if (Request.IsAuthenticated)
{
    // Kiểm tra thêm Session để chắc chắn người dùng đã đăng nhập vào hệ thống
    if (Session["TaiKhoan"] != null || Session["taikhoanadmin"] != null)
    {
        using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new { id = "logoutForm", @class = "pull-right" }))
        {
            @Html.AntiForgeryToken()

            <div class="col-auto">
                <ul class="top-nav">
                    <li>
                        @Html.ActionLink("Xin chào: " + User.Identity.GetUserName(), "Index", "Manage", routeValues: null, htmlAttributes: new { title = "Quản lý tài khoản" })
                    </li>
                    <li>
                        @Html.ActionLink("Đơn hàng của bạn", "DonHangDaMua", "Home")
                    </li>
                    <li><a class="btn-sm btn-outline-danger" href="javascript:document.getElementById('logoutForm').submit()">Đăng xuất</a></li>
                </ul>
            </div>
        }
    }
    else
    {
        // Trường hợp xác thực cookie còn nhưng session mất (ít gặp), hiện lại nút đăng nhập
        <div class="col-auto">
            <ul class="top-nav">
                <li>@Html.ActionLink("Đăng ký", "Register", "Account", routeValues: null, htmlAttributes: new { id = "registerLink" })</li>
                <li>@Html.ActionLink("Đăng nhập", "Login", "Account", routeValues: null, htmlAttributes: new { id = "loginLink" })</li>
            </ul>
        </div>
    }

}
else
{
    // Trường hợp Khách vãng lai (Chưa đăng nhập)
    <div class="col-auto">
        <ul class="top-nav">
            <li class="btn-sm btn-outline-primary">
                @Html.ActionLink("Đăng ký", "Register", "Account", routeValues: null, htmlAttributes: new { id = "registerLink", style = "text-decoration:none;" })
            </li>

            <li class="btn-sm btn-danger">
                @Html.ActionLink("Đăng nhập", "Login", "Account", routeValues: null, htmlAttributes: new { id = "loginLink", style = "color:white; text-decoration:none;" })
            </li>
        </ul>
    </div>
}